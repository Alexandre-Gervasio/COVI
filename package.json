{
  "name": "covi",
  "version": "1.2.5",
  "description": "C.O.V.I. — Conversor Otimizado de Vários formatos de Imagem. Converta. Simplifique. Pronto.",
  "main": "main.js",
  "author": {
    "name": "Alexandre",
    "email": "alexandrework010@gmail.com"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "heic2any": "0.0.4",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.alexandre.conversorheic",
    "productName": "C.O.V.I.",
    "publish": [
      {
        "provider": "github",
        "owner": "Alexandre-Gervasio",
        "repo": "COVI"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "prompt.html",
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "artifactName": "C.O.V.I-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.photography"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics",
      "maintainer": "Alexandre <alexandrework010@gmail.com>"
    }
  }
}
